# === Server ===
PORT=3100
LOG_LEVEL=info

# === Postgres principal (ChatMultiConta) ===
# Preenchido depois — por enquanto deixa vazio pra testar sem conectar
DATABASE_URL=

# === pg-boss (pode ser o mesmo banco do ChatMultiConta) ===
# Se vazio, usa DATABASE_URL
QUEUE_DATABASE_URL=

# === Meta Cloud API (fallback se a conta não tiver config própria no banco) ===
# Normalmente cada conta em chat_contas.config traz o seu access_token
META_API_VERSION=v26.0

# === Flags de desenvolvimento ===
# true = não envia pra Meta de verdade, só loga
DRY_RUN=true
